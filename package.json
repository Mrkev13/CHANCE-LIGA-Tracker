{
  "name": "fortuna-liga-tracker",
  "version": "1.0.0",
  "description": "Webová aplikace pro sledování české fotbalové ligy FORTUNA:LIGA",
  "main": "index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev:server": "nodemon server/index.js",
    "dev:client": "cd client && npm start",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "install:all": "npm install && cd client && npm install",
    "build": "npm run build:server && npm run build:client",
    "build:server": "npm install",
    "build:client": "cd client && npm install && npm run build",
    "test": "jest",
    "test:client": "cd client && npm test -- --watchAll=false",
    "scrape": "node -e \"require('./server/scrapeMatch').scrapeMatch(process.argv[process.argv.length - 1]).then(d => console.log(JSON.stringify(d, null, 2)))\"",
    "cron": "node server/index.js"
  },
  "keywords": [
    "fotbal",
    "liga",
    "fortuna",
    "česká",
    "liga",
    "živé",
    "skóre"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.6",
    "cheerio": "^1.2.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "mongoose": "^9.1.3",
    "node-cron": "^4.2.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "concurrently": "^8.0.1",
    "jest": "^30.3.0",
    "mongodb-memory-server": "^11.0.1",
    "nock": "^14.0.11",
    "nodemon": "^2.0.22",
    "supertest": "^7.2.2"
  }
}
